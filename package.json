{
  "name": "kodewords",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "scripts": {
    "web": "npm run web --workspace=frontend",
    "server": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "start": "tsx",
    "install:all": "npm install --workspace=frontend && npm install --workspace=server",
    "build": "npm run build --prefix frontend",
    "deploy": "npm run build && wrangler pages deploy frontend/build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blendjam/kodewords.git"
  },
  "workspaces": [
    "frontend",
    "server"
  ],
  "author": "blendjam",
